# PostgreSQL connection string for the external database
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
# Set to false for local/non-TLS PostgreSQL; hosted databases normally use TLS.
DATABASE_SSL=true

# SMTP settings for direct email delivery
# Gmail: enable 2-Step Verification and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
